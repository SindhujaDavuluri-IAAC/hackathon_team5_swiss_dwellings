{
  "name": "team5-swiss-dwellings-app",
  "private": true,
  "type": "module",
  "description": "Password-protected Cloudflare Pages app for the Swiss Dwellings model",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "db:local": "wrangler d1 execute team5-swiss-dwellings-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute team5-swiss-dwellings-db --remote --file=schema.sql",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "wrangler": "4.156.1"
  }
}
